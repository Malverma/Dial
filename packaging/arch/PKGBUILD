# Maintainer: Chase Cunningham <chasecunningham2004@gmail.com>
pkgname=dimmer
pkgver=0.1.0
pkgrel=1
pkgdesc="Per-monitor brightness control with backlight, DDC/CI, gamma and overlay backends"
url="https://github.com/Malverma/Linux-Dimmer"
arch=('x86_64' 'aarch64')
license=('unknown')
depends=('gtk4' 'libadwaita' 'gtk4-layer-shell' 'glib2' 'glibc' 'gcc-libs')
optdepends=('ddcutil: diagnostics for DDC/CI monitors (not required)')
makedepends=('cargo')
replaces=('linuxdimmer')
conflicts=('linuxdimmer')
source=()
sha256sums=()

# Builds from the local checkout two levels up.
_root="$startdir/../.."

prepare() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release
}

check() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --release
}

package() {
  cd "$_root"
  install -Dm755 "$srcdir/target/release/dimmer" "$pkgdir/usr/bin/dimmer"
  install -Dm644 data/io.github.dimmer.desktop "$pkgdir/usr/share/applications/io.github.dimmer.desktop"
  install -Dm644 data/io.github.dimmer.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.dimmer.svg"
  install -Dm644 data/dimmer-i2c.conf "$pkgdir/usr/lib/modules-load.d/dimmer-i2c.conf"
  install -Dm644 data/60-dimmer-i2c.rules "$pkgdir/usr/lib/udev/rules.d/60-dimmer-i2c.rules"
}
