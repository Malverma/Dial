# Maintainer: Chase Cunningham <chasecunningham2004@gmail.com>
pkgname=dial
pkgver=1.1.0
pkgrel=1
pkgdesc="Per-monitor brightness and audio volume control with a spectrum meter"
url="https://github.com/Malverma/Dial"
arch=('x86_64' 'aarch64')
license=('unknown')
depends=('gtk4' 'libadwaita' 'gtk4-layer-shell' 'glib2' 'glibc' 'gcc-libs' 'libpulse')
optdepends=('ddcutil: diagnostics for DDC/CI monitors (not required)')
makedepends=('cargo')
replaces=('linuxdimmer' 'dimmer')
conflicts=('linuxdimmer' 'dimmer')
source=()
sha256sums=()

# Builds from the local checkout two levels up.
_root="$startdir/../.."

prepare() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release
}

check() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --release
}

package() {
  cd "$_root"
  install -Dm755 "$srcdir/target/release/dial" "$pkgdir/usr/bin/dial"
  install -Dm644 data/io.github.dial.desktop "$pkgdir/usr/share/applications/io.github.dial.desktop"
  install -Dm644 data/io.github.dial.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.dial.svg"
  install -Dm644 data/dial-i2c.conf "$pkgdir/usr/lib/modules-load.d/dial-i2c.conf"
  install -Dm644 data/60-dial-i2c.rules "$pkgdir/usr/lib/udev/rules.d/60-dial-i2c.rules"
}
